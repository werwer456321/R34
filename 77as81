loadstring(game:HttpGet("https://raw.githubusercontent.com/clemonlang/clemon_roclothes/refs/heads/main/ClemonRC.lua"))()

task.spawn(function()
    local player = game.Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local UIS = game:GetService("UserInputService")
    local VIM = game:GetService("VirtualInputManager")

    -- Đợi ClemonRC load
    task.wait(1)

    if playerGui:FindFirstChild("SimpleCButton") then
        playerGui.SimpleCButton:Destroy()
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SimpleCButton"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = playerGui

    local button = Instance.new("TextButton")
    button.Name = "OButton"
    button.Size = UDim2.new(0, 36, 0, 36)
    button.Position = UDim2.new(0.9, 0, 0.8, 0)
    button.BackgroundColor3 = Color3.fromRGB(13, 98, 90)
    button.Text = "O"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Active = true
    button.Parent = screenGui

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", button)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(45, 100, 255)

    local originalPos = button.Position
    local clickCount = 0
    local clickToken = 0
    local DOUBLE_WINDOW = 0.55 -- dễ ấn hơn
    local busy = false

    local function setPressed(on)
        if on then
            button.BackgroundColor3 = Color3.fromRGB(0, 100, 220)
            button.TextColor3 = Color3.fromRGB(255, 255, 100)
        else
            button.BackgroundColor3 = Color3.fromRGB(13, 98, 90)
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.Text = "O"
            button.Position = originalPos
        end
    end

    local function sendC()
        -- Cách 1: VirtualInputManager
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.C, false, game)
        end)
        task.wait(0.06)
        pcall(function()
            VIM:SendKeyEvent(false, Enum.KeyCode.C, false, game)
        end)

        -- Cách 2: gửi thêm lần nữa cho chắc (một số executor hay nuốt 1 lần)
        task.wait(0.03)
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.C, false, game)
        end)
        task.wait(0.05)
        pcall(function()
            VIM:SendKeyEvent(false, Enum.KeyCode.C, false, game)
        end)
    end

    local function doToggle()
        if busy then return end
        busy = true
        setPressed(true)
        button.Text = "OK"
        pcall(sendC)
        task.delay(0.2, function()
            setPressed(false)
            busy = false
            clickCount = 0
        end)
    end

    -- Double-tap (dùng Activated = ổn định mobile + PC)
    button.Activated:Connect(function()
        if busy then return end

        clickCount += 1
        clickToken += 1
        local myToken = clickToken

        if clickCount == 1 then
            button.Text = "1/2"
            button.BackgroundColor3 = Color3.fromRGB(180, 120, 30)
            task.delay(DOUBLE_WINDOW, function()
                if myToken == clickToken and clickCount < 2 then
                    clickCount = 0
                    setPressed(false)
                end
            end)
        elseif clickCount >= 2 then
            clickCount = 0
            doToggle()
        end
    end)

    -- Kéo nút
    local dragging, dragStart, startPos
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
            originalPos = button.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            button.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
            originalPos = button.Position
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Phím C thật → highlight
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.C then
            setPressed(true)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.C then
            setPressed(false)
        end
    end)

    -- Reset → 0.5s tự gửi C
    local function onCharacter(char)
        task.wait(0.5)
        if not char or not char.Parent then return end
        -- đợi thêm chút cho ClemonRC gắn model
        task.wait(0.3)
        if not char or not char.Parent then return end
        pcall(sendC)
        print("✅ Auto kích hoạt sau reset")
    end

    if player.Character then
        task.spawn(onCharacter, player.Character)
    end
    player.CharacterAdded:Connect(onCharacter)

    print("✅ Nút O sẵn sàng | Ấn 2 lần (hiện 1/2 rồi OK)")
end)
